{
  "name": "card-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser front end for the CARD model. Runs the real `card` Python package under Pyodide.",
  "scripts": {
    "precomputed": "python3 tools/generate_precomputed.py",
    "precomputed:check": "python3 tools/generate_precomputed.py --check",
    "wheel": "bash tools/build_wheel.sh",
    "vendor": "node tools/vendor-pyodide.mjs",
    "setup": "npm run wheel && npm run vendor && npm run precomputed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "pyodide": "314.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.12"
  }
}
